# Model used only by the Python Agent execution service.
MODEL_PROVIDER=remote
MODEL_API_BASE=https://api.deepseek.com
MODEL_API_KEY=
MODEL_NAME=deepseek-v4-flash
LOCAL_MODEL_API_BASE=http://host.docker.internal:8010/v1
LOCAL_MODEL_NAME=local-deepseek-r1-distill-qwen-1.5b
AGENT_MAX_STEPS=16

# PostgreSQL. POSTGRES_PASSWORD has no application default and must be replaced.
POSTGRES_DB=aio_agent
POSTGRES_USER=aio_agent
POSTGRES_PASSWORD=

# Bootstrap administrator. Existing bootstrap admin passwords are rotated to this value on startup.
AIO_BOOTSTRAP_ADMIN_USERNAME=admin
AIO_BOOTSTRAP_ADMIN_PASSWORD=
AIO_PUBLIC_REGISTRATION_ENABLED=false

# Required service secrets. Use different random values with at least 32 characters.
AIO_JWT_SECRET=
INTERNAL_SERVICE_TOKEN=

# One-time, idempotent import of data/app.sqlite3 into PostgreSQL.
AIO_LEGACY_IMPORT_ENABLED=false
AIO_LEGACY_OWNER_USERNAME=admin

# Automatic PostgreSQL backups.
POSTGRES_BACKUP_INTERVAL_SECONDS=86400
POSTGRES_BACKUP_RETENTION_DAYS=7

# Production-only paths. The workspace directory must be writable by uid/gid 10001.
AIO_WORKSPACE_HOST_PATH=./workspaces
AIO_TLS_CERT_DIR=./deploy/certs

LOG_LEVEL=INFO
DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILES=5
