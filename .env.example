# Model used only by the Python Agent execution service.
MODEL_PROVIDER=remote
MODEL_API_BASE=https://api.deepseek.com
MODEL_API_KEY=
MODEL_NAME=deepseek-v4-flash
MODEL_REMOTE_ALLOWED_HOSTS=api.deepseek.com
MODEL_LOCAL_ALLOWED_HOSTS=host.docker.internal,localhost,127.0.0.1
MODEL_TIMEOUT_SECONDS=120
MODEL_MAX_RETRIES=3
LOCAL_MODEL_API_BASE=http://host.docker.internal:8998/v1
LOCAL_MODEL_NAME=minimind
AGENT_MAX_STEPS=16

# PostgreSQL. POSTGRES_PASSWORD has no application default and must be replaced.
POSTGRES_DB=aio_agent
POSTGRES_USER=aio_agent
POSTGRES_PASSWORD=

# Redis is used for the distributed run queue, cancellation, rate limits and SSE notifications.
REDIS_PASSWORD=
AIO_REDIS_KEY_PREFIX=aio

# Disabled in public deployments. Enable only for workspaces whose test code you trust.
AIO_ENABLE_LOCAL_TEST_TOOL=false

# Bootstrap administrator. Existing bootstrap admin passwords are rotated to this value on startup.
AIO_BOOTSTRAP_ADMIN_USERNAME=admin
AIO_BOOTSTRAP_ADMIN_PASSWORD=
AIO_PUBLIC_REGISTRATION_ENABLED=false
AIO_TOKEN_TTL=15m
AIO_REFRESH_TOKEN_TTL=30d
AIO_LOGIN_ATTEMPTS_PER_MINUTE=10
AIO_RUNS_PER_MINUTE=20
AIO_DAILY_TOKEN_LIMIT=200000

# Required service secrets. Use different random values with at least 32 characters.
AIO_JWT_SECRET=
INTERNAL_SERVICE_TOKEN=

# One-time, idempotent import of data/app.sqlite3 into PostgreSQL.
AIO_LEGACY_IMPORT_ENABLED=false
AIO_LEGACY_OWNER_USERNAME=admin

# Automatic PostgreSQL backups.
POSTGRES_BACKUP_INTERVAL_SECONDS=86400
POSTGRES_BACKUP_RETENTION_DAYS=7
# Optional production profile: docker compose --profile offsite-backup ...
POSTGRES_BACKUP_REMOTE=
POSTGRES_BACKUP_OFFSITE_INTERVAL_SECONDS=3600
RCLONE_CONFIG_PATH=./deploy/rclone.conf

# Optional observability profile. The file contains one Alertmanager webhook URL.
ALERT_WEBHOOK_URL_FILE=./deploy/alert-webhook-url

# Production-only paths. The workspace directory must be writable by uid/gid 10001.
AIO_WORKSPACE_HOST_PATH=./workspaces
AIO_TLS_CERT_DIR=./deploy/certs

LOG_LEVEL=INFO
DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILES=5
